# Copy to .env and adjust as needed. Database values are consumed by docker-compose.yml.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=grocery_products

# Prisma connection string
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/grocery_products"

# OpenAI Agents SDK (uses the Viber inference endpoint)
OPENAI_API_KEY=""
OPENAI_BASE_URL="https://inference.hackersquad.io/v1"
